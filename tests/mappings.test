# Mapping slots match solc: keccak256(pad32(key) ++ slot), or key ++ slot for
# a string key. Expected slots were computed with an independent keccak.
contract contracts/mappings.sol

setNumber(uint256,uint256) 7 100
    storage 0xdc686ec4a0ff239c70e7c7c36e8f853eced3bc8618f48d2b816da2a74311237e = 100
    storage 0x0 = 100
    # keccak runs as SP1's precompile: one permutation for a 64-byte preimage.
    syscall KECCAK_PERMUTE 1
byNumber(uint256) 7
    returns 100
byNumber(uint256) 8
    returns 0

setAddress(address,uint256) 0xabcd 5
    storage 0x01faefabee0c1b2040e07e2151ec1b32c8f39cc788b6c6991fb3408cb4910eac = 5
byAddress(address) 0xabcd
    returns 5

# nested[a][b]: keccak(pad(b) ++ keccak(pad(a) ++ 3)).
setNested(address,address,uint256) 0xa 0xb 9
    storage 0x21c324ff47714b60a3b024b87c239034ab80bd75118640c4845df95dc9fd79b3 = 9
addNested(address,address,uint256) 0xa 0xb 1
    storage 0x21c324ff47714b60a3b024b87c239034ab80bd75118640c4845df95dc9fd79b3 = 10
nested(address,address) 0xa 0xb
    returns 10
nested(address,address) 0xb 0xa
    returns 0

# bytes4 keys are left-aligned, int8 keys sign-extended.
setFlag(bytes4,bool) 0xcafebabe00000000000000000000000000000000000000000000000000000000 true
    storage 0x9a56c5317ed65e3c0ed48e542a46afb2f4709763bb4c7238a6bd3a0788a984a7 = 1
setSigned(int8,uint8) -1 3
    storage 0x2e8de2577e7c560a9913fd732cd5ba1f61f809b10c283800da9499091ac562a5 = 3
bySigned(int8) -1
    returns 3

# A struct value takes consecutive slots from the hashed one.
setPoint(uint256,uint64,int64) 1 2 -3
    storage 0x3e5fec24aa4dc4e5aee2e025e51e1392c72a2500577559fae9665c6d52bd6a31 = 2
    storage 0x3e5fec24aa4dc4e5aee2e025e51e1392c72a2500577559fae9665c6d52bd6a32 = 0xfffffffffffffffd
points(uint256) 1
    returns 2 -3
clearPoint(uint256) 1
    storage 0x3e5fec24aa4dc4e5aee2e025e51e1392c72a2500577559fae9665c6d52bd6a31 = 0
    storage 0x3e5fec24aa4dc4e5aee2e025e51e1392c72a2500577559fae9665c6d52bd6a32 = 0

setAlice(uint256) 42
    storage 0xa478e43b88f0bf0999792486cdb85c44a79ae39db2de1d4da061e8d73f2e6ba9 = 42
alice()
    returns 42
# The getter takes the key as a string argument.
byName(string) "alice"
    returns 42
byName(string) "bob"
    returns 0

hashWord(uint256) 1
    returns 0xb10e2d527612073b26eecdfd717e6a320cf44b4afac2b0732d9fcbe2b7fa0cf6
    syscall KECCAK_PERMUTE 1
# Constant inputs are hashed at compile time.
hashEmpty()
    returns 0xc5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470
    syscall KECCAK_PERMUTE 0
hashText()
    returns 0x1c8aff950685c2ed4bc3174f3472287b56d9517b9c948127319a09a7a36deac8
