#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BUILD="$ROOT/build"
SOLANG_DIR="${SOLANG_DIR:-$HOME/void/projects/solang}"
SOLANG_BRANCH="sp1-target"

if [[ -z "${LLVM_SYS_160_PREFIX:-}" ]]; then
    for prefix in "$HOME/llvm16/llvm16.0" "$HOME/opt/solang-llvm/llvm16.0"; do
        [[ -d "$prefix" ]] && export LLVM_SYS_160_PREFIX="$prefix" && break
    done
fi
export PATH="$HOME/.sp1/bin:$PATH"

usage() {
    cat <<EOF
usage: ./prova COMMAND

  setup                     build Solang (branch $SOLANG_BRANCH) and its RISC-V stdlib
  compile FILE.sol...       compile every contract in the files to build/contracts/
  run STEP...               execute transactions in SP1, one after another
  prove STEP...             execute all steps but the last, then prove the last one
  test [FILE...]            run test scripts (default: tests/*.test)
  bench FILE...             run a test script natively and in revm, compare cycles
  inspect                   symbols, ISA and disassembly of each contract
  clean                     remove build/

a STEP is one quoted transaction:
  'deploy [NAME] ARG...'    deploy contract NAME (needed if several are linked)
  'SIGNATURE ARG...'        call a function, like 'inc(uint32) 5' or 'get()'
ARG is one 32-byte ABI word: 42, -1, true, false or 0xHEX.

example:
  ./prova compile contracts/incrementer.sol
  ./prova run 'deploy 5' 'inc(uint32) 5' 'get()'

env: SOLANG_DIR (default ~/void/projects/solang), LLVM_SYS_160_PREFIX,
     SOLANG_FLAGS (extra flags for solang compile, e.g. --no-cse)
EOF
}

step() { printf '\033[1;34m==> %s\033[0m\n' "$*"; }
die() { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

solang_bin() { echo "$SOLANG_DIR/target/debug/solang"; }

check_branch() {
    local branch
    branch="$(git -C "$SOLANG_DIR" branch --show-current 2>/dev/null || true)"
    if [[ "$branch" != "$SOLANG_BRANCH" ]]; then
        die "$SOLANG_DIR is on branch '$branch', not '$SOLANG_BRANCH'"
    fi
}

llvm_bin_dir() {
    local dir
    IFS=: read -ra dirs <<<"$PATH"
    for dir in "${dirs[@]}"; do
        if [[ -x "$dir/llvm-objdump" ]] && "$dir/llvm-objdump" --version 2>/dev/null | grep -q riscv64; then
            echo "$dir"
            return
        fi
    done
    die "no llvm-objdump with RISC-V support on PATH"
}

cmd_setup() {
    check_branch
    [[ -n "${LLVM_SYS_160_PREFIX:-}" ]] || die "set LLVM_SYS_160_PREFIX to Solang's LLVM 16"
    export PATH="$LLVM_SYS_160_PREFIX/bin:$PATH"

    # target/riscv is shared with the r55 branch, which builds it with other flags.
    step "rebuilding the RISC-V stdlib bitcode"
    rm -rf "$SOLANG_DIR/target/riscv"
    make -C "$SOLANG_DIR/stdlib" -s

    step "building solang"
    (cd "$SOLANG_DIR" && cargo build -q)
    echo "solang: $(solang_bin)"
}

# Every contract in the files is linked into the guest. Solang names the entry
# points solang_deploy/solang_call in every object; they are renamed to
# prova_deploy_NAME/prova_call_NAME here so that the objects can be linked
# together.
cmd_compile() {
    [[ $# -ge 1 ]] || die "usage: ./prova compile FILE.sol..."
    [[ -x "$(solang_bin)" ]] || die "solang is not built, run ./prova setup"
    check_branch
    local file out objcopy names=() name i=0
    objcopy="$(llvm_bin_dir)/llvm-objcopy"

    rm -rf "$BUILD/out" "$BUILD/contracts" "$BUILD/contracts.txt"
    mkdir -p "$BUILD/contracts"
    for file in "$@"; do
        [[ -f "$file" ]] || die "$file not found"
        out="$BUILD/out/$i"
        i=$((i + 1))
        mkdir -p "$out"
        step "compiling $file with solang --target riscv"
        # shellcheck disable=SC2086 # SOLANG_FLAGS is a list of flags
        "$(solang_bin)" compile --target riscv ${SOLANG_FLAGS:-} "$(realpath "$file")" -o "$out" 2>&1 \
            | grep -v "is not a recognized feature" || true
        for object in "$out"/*.o; do
            [[ -f "$object" ]] || die "no object file was produced for $file"
            name="$(basename "$object" .o)"
            [[ ! -f "$BUILD/contracts/$name.o" ]] || die "two contracts are named $name"
            "$objcopy" --redefine-sym "solang_deploy=prova_deploy_$name" \
                --redefine-sym "solang_call=prova_call_$name" \
                "$object" "$BUILD/contracts/$name.o"
            names+=("$name")
        done
    done

    printf '%s\n' "${names[@]}" >"$BUILD/contracts.txt"
    for name in "${names[@]}"; do
        echo "build/contracts/$name.o ($(stat -c %s "$BUILD/contracts/$name.o") bytes)"
    done
}

require_contract() {
    [[ -f "$BUILD/contracts.txt" ]] || die "no contract yet, run ./prova compile FILE.sol"
    step "contracts: $(paste -sd' ' "$BUILD/contracts.txt")"
}

host() {
    require_contract
    [[ $# -ge 1 ]] || die "give at least one step, see ./prova help"
    (cd "$ROOT" && cargo run --release -q -p prova-host -- "$@")
}

# Each test file names its contracts on `contract FILE.sol` lines, and may
# give extra Solang flags on a `solang FLAGS` line.
compile_for() {
    local file="$1" contract
    mapfile -t contract < <(sed -n 's/#.*//; s/^contract[[:space:]]\+\([^[:space:]]*\).*/\1/p' "$file")
    [[ ${#contract[@]} -ge 1 ]] || die "$file has no 'contract FILE.sol' line"
    (cd "$ROOT" && SOLANG_FLAGS="${SOLANG_FLAGS:-} $(sed -n 's/#.*//; s/^solang[[:space:]]\+//p' "$file")" \
        cmd_compile "${contract[@]}") >/dev/null
    printf '%s\n' "${contract[@]}"
}

cmd_test() {
    local files=("$@") failed=() file
    [[ ${#files[@]} -gt 0 ]] || files=("$ROOT"/tests/*.test)

    for file in "${files[@]}"; do
        file="$(realpath "$file")"
        compile_for "$file" >/dev/null
        file="$(realpath --relative-to="$ROOT" "$file")"
        step "test $file"
        (cd "$ROOT" && cargo run --release -q -p prova-host -- --test "$file") || failed+=("$file")
    done

    if [[ ${#failed[@]} -gt 0 ]]; then
        die "failed: ${failed[*]}"
    fi
    echo "all ${#files[@]} test files passed"
}

# Runs a test file's steps natively and as solc bytecode in revm.
cmd_bench() {
    [[ $# -ge 1 ]] || die "usage: ./prova bench FILE.test..."
    command -v solc >/dev/null || die "the benchmark needs solc on PATH"
    local file contract
    for file in "$@"; do
        file="$(realpath "$file")"
        mapfile -t contract < <(compile_for "$file")
        rm -rf "$BUILD/evm"
        (cd "$ROOT" && solc --optimize --bin --bin-runtime -o "$BUILD/evm" "${contract[@]}") >/dev/null
        file="$(realpath --relative-to="$ROOT" "$file")"
        step "bench $file (solc $(solc --version | sed -n 's/^Version: \([^+]*\).*/\1/p') --optimize)"
        (cd "$ROOT" && cargo run --release -q -p prova-host -- --bench "$file")
    done
}

cmd_inspect() {
    require_contract
    local llvm name object
    llvm="$(llvm_bin_dir)"
    while read -r name; do
        object="$BUILD/contracts/$name.o"
        echo "$name: symbols (T = exported to the guest, W = weak, U = the guest must provide it):"
        "$llvm/llvm-nm" "$object" | grep -E ' [TWU] ' | sed 's/^/  /'
        echo "  ISA: $("$llvm/llvm-readelf" -A "$object" | grep -o 'rv64[a-z0-9_]*' | head -1)"
        "$llvm/llvm-objdump" -d --no-show-raw-insn "$object" >"$BUILD/contracts/$name.s"
        echo "  disassembly: build/contracts/$name.s"
    done <"$BUILD/contracts.txt"
}

case "${1:-help}" in
setup) shift; cmd_setup "$@" ;;
compile) shift; cmd_compile "$@" ;;
run) shift; host "$@" ;;
prove) shift; host --prove "$@" ;;
test) shift; cmd_test "$@" ;;
bench) shift; cmd_bench "$@" ;;
inspect) shift; cmd_inspect ;;
clean) rm -rf "$BUILD" ;;
help | -h | --help) usage ;;
*) usage; exit 1 ;;
esac
